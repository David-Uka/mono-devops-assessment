{
  "name": "devops-assessment-api",
  "version": "1.0.0",
  "description": "TypeScript Node.js API (Express + routing-controllers + TypeDI) exposing /health, /metrics and /getAccount endpoints",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.22.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.10.4",
    "typedi": "^0.10.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "multer": "^2.3.0"
  }
}
